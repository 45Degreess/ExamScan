# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=examscan
DB_PASSWORD=replace-with-a-random-password
DB_ROOT_PASSWORD=replace-with-another-random-password
DB_NAME=examscan

# First administrator (used only when the users table is empty)
EXAMSCAN_BOOTSTRAP_UCT_ID=ABCDEF001
EXAMSCAN_BOOTSTRAP_NAME=ExamScan Administrator
EXAMSCAN_BOOTSTRAP_EMAIL=administrator@example.ac.za

# Password email delivery. These defaults target the local Mailpit service.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=none
SMTP_FROM=ExamScan <examscan@example.ac.za>

# Browser/API boundary
EXAMSCAN_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
MAILPIT_UI_PORT=8025
